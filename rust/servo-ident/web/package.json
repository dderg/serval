{
  "name": "servo-ident-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "bun build index.html --outdir \"${SERVO_WEB_OUTDIR:-dist}\" --sourcemap=linked",
    "check": "tsc --noEmit",
    "generate:openapi": "openapi-typescript openapi.json --output src/api/openapi.generated.ts",
    "test": "for f in test/*.test.ts; do bun test \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@tanstack/preact-query": "^5",
    "htm": "3.1.1",
    "openapi-fetch": "^0.17.0",
    "preact": "~10.29.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/bun": "^1.3.14",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
