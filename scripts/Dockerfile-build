FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
RUN mkdir /ci_build

# Install dependencies. No MCU cross-toolchains here: the only supported
# firmware is the kalico motion-runtime firmware (H723/F446/G0B1 + Linux
# MCU), which needs the Rust toolchain and is built+linked by the dedicated
# ci-mcu-firmware.yaml workflow. This image only runs the klippy host-side
# python suite (build-essential covers chelper / test shim C builds).
RUN apt update \
    && apt install -y sudo git curl \
      python3 python3-dev python3-venv libffi-dev build-essential \
      pkg-config libudev-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Rust toolchain for the _config_doc parser module klippy needs at startup.
# The version comes from rust-toolchain.toml (single source of truth);
# RUSTUP_TOOLCHAIN overrides the toml at cargo time so this image never
# downloads the cross-compilation targets the firmware builds want.
COPY rust/rust-toolchain.toml /tmp/rust-toolchain.toml
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain \
      "$(sed -n 's/^channel = "\(.*\)"/\1/p' /tmp/rust-toolchain.toml)"
ENV PATH="/root/.cargo/bin:${PATH}"

# Built from rust/ alone so Python-only edits keep this layer cached.
# Installed OUTSIDE /klipper: the test container bind-mounts the host
# checkout over /klipper, which would shadow anything placed in the tree;
# klippy/configfile.py probes $KALICO_NATIVE_DIR by explicit path.
COPY rust/ /build-rust/
RUN cd /build-rust \
    && RUSTUP_TOOLCHAIN="$(sed -n 's/^channel = "\(.*\)"/\1/p' /tmp/rust-toolchain.toml)" \
       cargo build -p config-py -p motion-engine -p shaper-ident --release \
         --features config-py/extension-module,motion-engine/extension-module,shaper-ident/extension-module \
    && mkdir -p /opt/kalico-native \
    && cp target/release/lib_config_doc.so /opt/kalico-native/_config_doc.so \
    && cp target/release/lib_motion_engine.so /opt/kalico-native/_motion_engine.so \
    && cp target/release/lib_shaper_ident.so /opt/kalico-native/_shaper_ident.so \
    && rm -rf /build-rust
ENV KALICO_NATIVE_DIR=/opt/kalico-native

COPY . /klipper
WORKDIR /klipper

RUN uv run ./scripts/ci-build.sh

ENTRYPOINT [ "/bin/uv", "run" ]
CMD [ "py.test" ]
