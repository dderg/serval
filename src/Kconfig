config MOTION_SAMPLE_RATE_HZ
    int "Motion engine sample rate in Hz (motion-timer ISR fire rate)" if LOW_LEVEL_OPTIONS
    depends on MACH_STM32H7 || MACH_STM32F4 || MACH_STM32F1 || MACH_STM32G0 || MACH_LINUX
    default 10000 if MACH_STM32H7
    default 5000 if MACH_STM32F401
    default 10000 if MACH_STM32F4
    default 2000 if MACH_STM32F1
    default 2000 if MACH_STM32G0
    default 1000 if MACH_LINUX
    default 10000
    range 1000 100000
    help
      Rate at which the motion-engine ISR evaluates motion curves and emits
      step pulses. Higher rates give better velocity-extrapolation accuracy
      but cost more CPU. Defaults to 40 kHz on H7 (520 MHz) and 20 kHz
      on F4 (180 MHz). Defaults to 2 kHz on G0B1 (64 MHz Cortex-M0+,
      soft-float): this is a low-rate bring-up target, not a throughput
      target. Defaults to 1 kHz on MACH_LINUX: the host tick
      (linux/runtime_tick_host.c) drives the ISR from a clock_nanosleep loop
      whose resolution floor on a stock (non-PREEMPT_RT) kernel is ~1 ms, and
      this rate MUST equal the tick rate or the runtime's TickIntervalExceeded
      guard fires on the first active tick. Raising it requires a PREEMPT_RT
      kernel and a SCHED_FIFO launch (klipper_mcu -r).

# Motion-engine ISR timer selection. The physical timer is chosen per
# architecture via the alias in src/stm32/runtime_tick_timer.h: H7/F4 use
# TIM5 (hardcoded in their runtime_tick_{h7,f4}.c). STM32G0B1 has no TIM5
# (timers: TIM1/2/3/4/6/7/14/15/16/17), and TIM2 is already Klipper's 32-bit
# scheduler clock (stm32f0_timer.c), so the motion ISR needs a different free
# timer. TIM6/TIM7 are basic timers with no output channels — hard_pwm can
# never claim them — making them the safe choices. Default TIM7 (its only
# shared-vector neighbor is LPTIM2, unused on a toolhead board).
choice
    prompt "Motion-engine ISR timer (STM32G0)" if LOW_LEVEL_OPTIONS
    default MOTION_TIMER_TIM7
    depends on MACH_STM32G0 && MOTION_RUNTIME
    help
      Selects which hardware timer drives the motion-engine sample ISR on
      STM32G0. Pick one not otherwise used by your board's PWM/peripherals.
      TIM6 and TIM7 are basic timers (no PWM channels) and are the
      recommended choices.

    config MOTION_TIMER_TIM7
        bool "TIM7 (basic timer, shares vector with LPTIM2)"

    config MOTION_TIMER_TIM6
        bool "TIM6 (basic timer, shares vector with DAC/LPTIM1)"
endchoice

config RUNTIME_STORAGE_SIZE
    int "rt_storage byte ceiling" if LOW_LEVEL_OPTIONS
    depends on (MACH_STM32H7 || MACH_STM32F4 || MACH_STM32F1 || MACH_STM32G0 || MACH_LINUX) \
        && MOTION_RUNTIME
    default 32768 if MACH_STM32H7
    default 10240 if MACH_STM32F1
    default 20480 if MACH_STM32G0
    default 20480 if MACH_STM32F4
    default 393216 if MACH_LINUX
    default 32768
    range 8192 524288
    help
      Byte ceiling for rt_storage (the C-declared backing buffer that
      replaces RT_CELL's Rust-side #[link_section] placement). The C-side
      _Static_assert in src/runtime_storage.c enforces 2 KB headroom and
      the Rust-side const_assert fires if RuntimeContext exceeds this
      value at compile time.

      RuntimeContext is dominated by the per-lane sample-run rings:
      8 lanes * (RUNTIME_SAMPLE_RUNS_PER_LANE +
      RUNTIME_SAMPLE_OVERLAY_RUNS_PER_LANE) slots * 208 bytes, plus a
      1568-byte fixed part. Measured 28256 bytes at the H7 depths (12 + 3)
      and 14944 at the 4 + 3 defaults; 1568 with SAMPLE_STEPPING off.

      Per-MCU defaults: H7 32768 (the 12 + 3 depths plus headroom; on H7
      this lives in AXI SRAM whose ceiling is 320 KB). MACH_LINUX 393216
      (the 208 + 3 depths a host MCU's lane ring carries). F4 and G0 20480
      (the 4 + 3 depths plus headroom). F103 (48 KB SRAM total) 10240:
      SAMPLE_STEPPING is off there, so the fixed part is all that is
      needed, and every byte above it is taken straight out of the C
      dynamic pool, which is the scarce resource on that part. Enabling
      SAMPLE_STEPPING on F103 trips the static assert rather than silently
      overflowing.

config MCU_SIM
    bool "Build for simulator (disables IWDG, enables Linux sim shims)"
    default n
    help
      Builds a sim-flavor image: skips watchdog_init / watchdog_reset
      so Renode's IWDG model can't trigger spurious resets, and (on
      MACH_LINUX) replaces real /dev/gpiochip / /dev/spidev / /sys/iio
      / /sys/class/pwm access with in-memory stubs and Unix-socket
      passthroughs to chip emulators. NEVER enable for a flashed-to-
      silicon build — it leaves the IWDG effectively off, which is
      unsafe on real hardware.

config MCU_SIM_TMCUART_BYPASS
    bool "Bypass tmcuart bit-bang and write bytes to a Unix socket"
    depends on MACH_LINUX
    default n
    help
      Sim-only escape hatch for the tmcuart driver. When enabled, the
      tmcuart_send command bypasses the GPIO bit-bang and writes raw
      bytes directly to ${MCU_SIM_SOCK_DIR}/tmcuart_<oid>. This is
      the one architectural exception to the otherwise-clean
      "production firmware knows nothing about sim" rule for MACH_LINUX
      builds — the bit-bang's timing fragility under Linux scheduler
      jitter would make a shim-side decoder flake intermittently.

menu "Motion dispatch modules"
    depends on (MACH_STM32H7 || MACH_STM32F4 || MACH_STM32F1 || MACH_STM32G0 || MACH_LINUX) \
        && MOTION_RUNTIME
config MOTION_MODULE_STEPPER
    bool "Stepper pulse/phase dispatch"
    default y if MACH_STM32H7 || MACH_STM32F4 || MACH_STM32F1 || MACH_STM32G0
    default n
    help
      Compiles the TMC phase-stepping dispatch backend into this firmware.
      Required for any build that drives stepper coils directly; a
      servo/EtherCAT node leaves it off.

config SAMPLE_STEPPING
    bool "Sample-stream execution for phase-stepped lanes"
    depends on MOTION_MODULE_STEPPER
    default n
    help
      Compiles the sample-stream executor, the only transport for
      phase-stepped motion. A phase lane the host anchors with
      sample_anchor is driven by linear interpolation between the samples
      of its sample_run stream; without this option a phase axis can only
      slew its commanded phase offset and never follows a trajectory.

config RUNTIME_SAMPLE_RUNS_PER_LANE
    int "Sample runs buffered per phase lane" if LOW_LEVEL_OPTIONS
    depends on SAMPLE_STEPPING
    default 12 if MACH_STM32H7
    default 208 if MACH_LINUX
    default 4
    range 2 256
    help
      Depth of each lane's sample-run ring. One run holds up to
      SAMPLE_RUN_COUNT_MAX (48) samples, so at a 40 kHz tick the default 12
      buffers roughly 14 ms of trajectory per lane. Each slot costs
      48*4 + 16 bytes out of RUNTIME_STORAGE_SIZE.

      The host never sends past this depth (the firmware advertises it as
      SAMPLE_RUNS_PER_LANE and the sample endpoint paces its window against
      the retirement heartbeat), so the depth is also the ceiling on how much
      lead a lane can hold, and the retirement credit has to complete its
      round trip inside that lead or the ring plays dry.

      Size the depth off the samples a run actually carries, not off
      SAMPLE_RUN_COUNT_MAX: the 48-byte payload closes a run as soon as the
      deltas fill it, which under motion is two bytes a delta and therefore
      about half the cap. MACH_LINUX takes 208 - a host MCU has RAM to
      spare, its clock is a software clock the host's estimate tracks far
      more loosely than a hardware timer, and its foreground task loop
      delivers the retirement heartbeat tens of milliseconds apart rather
      than the 2 ms a hardware board manages, so the lane needs several
      send leads resident rather than a hardware board's few milliseconds.

config RUNTIME_SAMPLE_OVERLAY_RUNS_PER_LANE
    int "Overlay sample runs buffered per phase lane" if LOW_LEVEL_OPTIONS
    depends on SAMPLE_STEPPING
    default 3
    range 1 16
    help
      Depth of each lane's additive overlay ring. Overlay runs carry short
      nudges, so this is much shallower than the main ring.
endmenu

