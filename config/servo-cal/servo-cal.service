# servo-cal dashboard — serves the calibration task pages off the captures
# root. Deploy on the printer host next to klippy; the same binary klippy
# invokes for `servo-cal analyze` serves the dashboard, so one build feeds
# both.
#
# Build on the printer host (same toolchain the flash script already uses
# for the motion engine):
#   cd ~/klipper/rust && cargo build --release -p servo-ident
#
# Install (printer-style, sudoers only passwordless-allows systemctl —
# same pattern as ~/observability): keep this unit in ~/servo-cal/ and
#   sudo systemctl enable --now /home/<user>/servo-cal/servo-cal.service
# or the standard way:
#   sudo cp servo-cal.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now servo-cal
#
# Adapt User= and the /home/pi paths to the host. After pulling a new
# branch build, rebuild and `sudo systemctl restart servo-cal`.
#
# Browser access needs the dashboard's origin in moonraker.conf so the
# pages can POST G-code:
#   [authorization]
#   cors_domains: http://<host>.local:8085
[Unit]
Description=servo-cal calibration dashboard
After=network.target

[Service]
Type=simple
User=pi
ExecStart=/home/pi/klipper/rust/target/release/servo-cal serve \
    --dir /home/pi/printer_data/logs/servo_captures \
    --port 8085
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
