# servo-cal dashboard — serves the calibration task pages off the captures
# root. Deploy on the printer host next to klippy.
#
# The service runs servo-cal-launcher.sh (kept OUTSIDE the repo, in
# ~/servo-cal/, because the repo checkout is branch-switched): it idles on
# branches without rust/servo-ident, and on branches that have it builds
# the release binary and serves. Restart=always makes the launcher's exit
# on a HEAD change (flash script pull / checkout) an automatic
# rebuild-and-restart — the unit follows whatever is checked out.
#
# Install (printer-style, sudoers only passwordless-allows systemctl —
# same pattern as ~/observability): put this unit and the launcher in
# ~/servo-cal/, `chmod +x servo-cal-launcher.sh`, then
#   sudo systemctl enable --now /home/<user>/servo-cal/servo-cal.service
# Adapt User= and the /home/pi paths to the host.
#
# Browser access needs the dashboard's origin in moonraker.conf so the
# pages can POST G-code:
#   [authorization]
#   cors_domains: http://<host>.local:8085
[Unit]
Description=servo-cal calibration dashboard
After=network.target

[Service]
Type=simple
User=pi
ExecStart=/home/pi/servo-cal/servo-cal-launcher.sh
Restart=always
RestartSec=10
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
